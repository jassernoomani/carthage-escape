# Copy to .env for local development (cargo run / sqlx-cli / cargo test).
DATABASE_URL=postgres://carthage:carthage@localhost:5432/carthage
BIND_ADDR=127.0.0.1:8080
RUST_LOG=carthage_server=debug,tower_http=info
# Signs player/host WebSocket tokens. Any random string of 32+ bytes; use a real secret in production.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Set to true when served over HTTPS.
COOKIE_SECURE=false
